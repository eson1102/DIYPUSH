    /************************************************************
     * 28. 初始化
     ************************************************************/

    function init() {

        loadMonitorState();

        createPanel();

        startMutationObserver();


        /*
         * 等待页面数据加载
         *
         * 很多交易页面不是一开始就有数据，
         * 所以连续尝试几次。
         */

        let retry = 0;


        const waitTimer =
            setInterval(
                () => {

                    retry++;

                    if (
                        document.querySelector(
                            '#products'
                        )
                    ) {

                        clearInterval(
                            waitTimer
                        );

                        startMonitoring();

                    } else if (
                        retry >= 20
                    ) {

                        clearInterval(
                            waitTimer
                        );

                        /*
                         * 即使暂时没找到，
                         * 仍然启动监控。
                         *
                         * 后续 AJAX 数据出现后
                         * MutationObserver 会触发检查。
                         */

                        startMonitoring();
                    }

                },
                500
            );
    }


    /*
     * DOM ready
     */

    if (
        document.readyState ===
        'loading'
    ) {

        document.addEventListener(
            'DOMContentLoaded',
            init
        );

    } else {

        init();
    }

