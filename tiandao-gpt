    /************************************************************
     * 22. 保存设置
     ************************************************************/

    function saveSettingsFromPanel() {

        const get =
            id =>
                document.querySelector(id);


        const intervalMinutes =
            parseInt(
                get('#tm-set-interval').value,
                10
            );


        config.interval =
            Math.max(
                1,
                intervalMinutes || 5
            ) * 60000;


        config.wechatEnabled =
            get('#tm-set-wechat').checked;


        config.wechatWebhook =
            get('#tm-set-webhook').value.trim();


        config.emailEnabled =
            get('#tm-set-email').checked;


        config.emailServiceId =
            get('#tm-set-service').value.trim();


        config.emailTemplateId =
            get('#tm-set-template').value.trim();


        config.emailPublicKey =
            get('#tm-set-public').value.trim();


        config.emailToEmail =
            get('#tm-set-email-to').value.trim();


        config.runNotify =
            get('#tm-set-run').checked;


        config.browserNotify =
            get('#tm-set-browser').checked;


        config.startupNotify =
            get('#tm-set-startup').checked;


        config.messageNew =
            get('#tm-msg-new').value;


        config.messageIncrease =
            get('#tm-msg-increase').value;


        config.messageDecrease =
            get('#tm-msg-decrease').value;


        config.messageClear =
            get('#tm-msg-clear').value;


        config.messageRun =
            get('#tm-msg-run').value;


        /*
         * 关键：
         *
         * 保存设置
         */

        saveConfig();


        /*
         * 如果监控已经运行，
         * 重建定时器，
         * 使新的间隔立即生效。
         */

        if (config.enabled) {

            startMonitor();

        } else {

            updateButton();

            updatePanel(
                null,
                '设置已保存'
            );
        }


        closeSettings();


        /*
         * 明确提示用户已经保存
         */

        browserNotify(
            '今仓监控',
            '设置已保存'
        );


        console.log(
            '[今仓监控] 设置保存完成',
            config
        );
    }


