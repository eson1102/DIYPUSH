// ==UserScript==
// @name         策略研究平台 - 今仓变化监控 Pro
// @namespace    https://hunansanhe.com/
// @version      4.0.0
// @description  监控交易页面今仓变化，支持企业微信机器人、EmailJS、后台持续监控、消息模板和控制面板
// @author       GPT
//
// @match        http://m.hunansanhe.com:20008/*
//
// @grant        GM_xmlhttpRequest
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_notification
// @grant        GM_registerMenuCommand
//
// @connect      m.hunansanhe.com
// @connect      qyapi.weixin.qq.com
// @connect      api.emailjs.com
//
// @run-at       document-idle
// @noframes
// ==/UserScript==

(function () {
    'use strict';

    /************************************************************
     * 1. 基础配置
     ************************************************************/

    const VERSION = '4.0.0';

    /*
     * 只允许这个站点运行。
     *
     * 注意：
     * 不限制 /ht/data.html
     *
     * 例如：
     * http://m.hunansanhe.com:20008/ht/data.html
     * http://m.hunansanhe.com:20008/ht/test.html
     * http://m.hunansanhe.com:20008/abc.html
     *
     * 都可以运行。
     */

    const ALLOWED_HOST = 'm.hunansanhe.com';
    const ALLOWED_PORT = '20008';

    if (
        location.hostname !== ALLOWED_HOST ||
        String(location.port) !== ALLOWED_PORT
    ) {
        return;
    }

    /************************************************************
     * 2. 默认配置
     ************************************************************/

    const DEFAULT_CONFIG = {

        enabled: true,

        /*
         * 首次启动：
         * true = 第一次读取只建立基准，不发送交易通知
         */
        firstRunAsBaseline: true,

        /*
         * 监控间隔
         * 单位：秒
         */
        interval: 30,

        /*
         * 页面没有数据时是否继续监控
         */
        retryWhenNoData: true,

        /*
         * 企业微信
         */
        wecomEnabled: true,

        wecomWebhook:
            'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=86748ff7-e6d0-4c5f-b915-958ae95a885b',

        /*
         * EmailJS
         */
        emailEnabled: false,

        emailServiceId: '',
        emailTemplateId: '',
        emailPublicKey: '',
        emailAccessToken: '',

        emailTo: '',

        /*
         * 运行通知
         *
         * true：
         * 启动、停止、异常、建立基准等发送通知
         */
        runtimeNotification: true,

        /*
         * 本地桌面通知
         */
        desktopNotification: true,

        /*
         * 消息模板
         */
        tradeMessageTemplate:
`📊 今仓发生变化

策略研究室：{{club}}

原今仓：{{old_total}} 手
当前今仓：{{new_total}} 手
变化：{{change}} 手

{{details}}

检查时间：{{time}}`,

        runtimeMessageTemplate:
`🔔 今仓监控运行通知

状态：{{status}}

页面：{{url}}

当前今仓：{{total}} 手

时间：{{time}}`,

        /*
         * 是否显示页面控制面板
         */
        showPanel: true,

        /*
         * 面板位置
         */
        panelLeft: 20,
        panelTop: 80
    };


    /************************************************************
     * 3. 状态
     ************************************************************/

    let config = loadConfig();

    let state = {

        running: config.enabled,

        initialized: false,

        lastTotal: null,

        currentTotal: null,

        lastCheckTime: null,

        lastChange: null,

        lastStatus: '等待第一次检查',

        checking: false,

        timer: null,

        observer: null,

        pageReady: false,

        lastDataSignature: '',

        runtimeStartedNotificationSent: false
    };


    /************************************************************
     * 4. 工具函数
     ************************************************************/

    function loadConfig() {

        const saved = GM_getValue('trade_monitor_config', null);

        if (!saved) {
            return JSON.parse(JSON.stringify(DEFAULT_CONFIG));
        }

        return Object.assign(
            {},
            DEFAULT_CONFIG,
            saved
        );
    }


    function saveConfig() {

        GM_setValue(
            'trade_monitor_config',
            config
        );
    }


    function nowString() {

        const d = new Date();

        const pad = n => String(n).padStart(2, '0');

        return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ` +
               `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    }


    function formatNumber(num) {

        if (num === null || num === undefined || isNaN(num)) {
            return '-';
        }

        return Number(num).toLocaleString(
            'zh-CN',
            {
                maximumFractionDigits: 2
            }
        );
    }


    function formatChange(num) {

        if (num > 0) {
            return '+' + formatNumber(num);
        }

        return formatNumber(num);
    }


    function escapeHtml(str) {

        return String(str ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }


    function parseNumber(value) {

        if (value === null || value === undefined) {
            return null;
        }

        let text = String(value)
            .replace(/,/g, '')
            .replace(/，/g, '')
            .replace(/\s+/g, '')
            .trim();

        if (!text) {
            return 0;
        }

        const n = parseFloat(text);

        return Number.isFinite(n) ? n : null;
    }


    /************************************************************
     * 5. 查找今仓列
     ************************************************************/

    function findTodayColumnIndex(table) {

        if (!table) {
            return -1;
        }

        const headers = table.querySelectorAll('thead tr:first-child td, thead tr:first-child th');

        let index = -1;

        headers.forEach((cell, i) => {

            const text = cell.innerText.trim();

            if (
                text === '今仓' ||
                text.includes('今仓')
            ) {
                index = i;
            }
        });

        return index;
    }


    /************************************************************
     * 6. 获取交易数据
     ************************************************************/

    function getTradeData() {

        /*
         * 优先使用页面原本的 products 表格
         */
        let table = document.querySelector('#products');

        let tbody = table;

        if (!tbody) {

            /*
             * 如果页面结构发生变化，
             * 尝试寻找包含“今仓”的表格。
             */

            const tables = document.querySelectorAll('table');

            for (const t of tables) {

                const text = t.innerText || '';

                if (
                    text.includes('今仓') &&
                    text.includes('昨仓')
                ) {

                    tbody = t.querySelector('tbody');

                    if (tbody) {
                        break;
                    }
                }
            }
        }

        if (!tbody) {

            return {
                success: false,
                reason: '找不到交易数据表格',
                total: null,
                rows: []
            };
        }

        /*
         * 找真正的 table
         */
        const tableElement = tbody.closest('table');

        const todayIndex =
            findTodayColumnIndex(tableElement);

        if (todayIndex < 0) {

            return {
                success: false,
                reason: '找不到“今仓”列',
                total: null,
                rows: []
            };
        }

        const rows = tbody.querySelectorAll('tr');

        let total = 0;

        let validRowCount = 0;

        const details = [];

        rows.forEach(row => {

            const cells = row.querySelectorAll('td,th');

            if (!cells.length) {
                return;
            }

            if (todayIndex >= cells.length) {
                return;
            }

            const name =
                cells[0]?.innerText.trim() || '';

            const symbol =
                cells[1]?.innerText.trim() || '';

            const direction =
                cells[2]?.innerText.trim() || '';

            const todayText =
                cells[todayIndex]?.innerText.trim() || '';

            const today =
                parseNumber(todayText);

            if (today === null) {
                return;
            }

            total += today;

            validRowCount++;

            details.push({
                name,
                symbol,
                direction,
                today
            });
        });


        /*
         * 如果没有任何有效行，
         * 不认为今仓是 0。
         */
        if (validRowCount === 0) {

            return {
                success: false,
                reason: '没有读取到有效今仓数据',
                total: null,
                rows: []
            };
        }


        /*
         * 获取策略研究室名称
         */
        let club = '';

        const clubTable =
            document.querySelector('#clubs');

        if (clubTable) {

            const firstRow =
                clubTable.querySelector('tr');

            if (firstRow) {

                club =
                    firstRow.querySelector('td')?.innerText.trim() || '';
            }
        }


        return {

            success: true,

            total,

            rows: details,

            club,

            time: nowString()
        };
    }


    /************************************************************
     * 7. 生成明细
     ************************************************************/

    function buildDetails(rows) {

        if (!rows || !rows.length) {
            return '无品种明细';
        }

        return rows
            .map(item => {

                return `${item.name || item.symbol} ` +
                       `${item.today}手`;
            })
            .join('\n');
    }


    /************************************************************
     * 8. 模板变量
     ************************************************************/

    function renderTemplate(template, data) {

        return String(template || '')
            .replace(/\{\{club\}\}/g,
                data.club ?? '')
            .replace(/\{\{old_total\}\}/g,
                formatNumber(data.oldTotal))
            .replace(/\{\{new_total\}\}/g,
                formatNumber(data.newTotal))
            .replace(/\{\{change\}\}/g,
                formatChange(data.change))
            .replace(/\{\{total\}\}/g,
                formatNumber(data.total))
            .replace(/\{\{details\}\}/g,
                data.details ?? '')
            .replace(/\{\{time\}\}/g,
                data.time ?? nowString())
            .replace(/\{\{status\}\}/g,
                data.status ?? '')
            .replace(/\{\{url\}\}/g,
                location.href);
    }


    /************************************************************
     * 9. 企业微信
     ************************************************************/

    function sendWeCom(text) {

        if (!config.wecomEnabled) {
            return Promise.resolve({
                success: false,
                skipped: true
            });
        }

        const webhook =
            String(config.wecomWebhook || '').trim();

        if (!webhook) {

            return Promise.resolve({
                success: false,
                reason: '企业微信 Webhook 未配置'
            });
        }


        return new Promise(resolve => {

            GM_xmlhttpRequest({

                method: 'POST',

                url: webhook,

                headers: {
                    'Content-Type': 'application/json'
                },

                data: JSON.stringify({

                    msgtype: 'text',

                    text: {
                        content: text
                    }

                }),

                timeout: 10000,

                onload: function (response) {

                    let data = null;

                    try {
                        data = JSON.parse(response.responseText);
                    } catch (e) {}

                    if (
                        response.status >= 200 &&
                        response.status < 300 &&
                        (!data || data.errcode === 0)
                    ) {

                        resolve({
                            success: true,
                            response: data
                        });

                    } else {

                        resolve({
                            success: false,
                            reason:
                                data?.errmsg ||
                                `HTTP ${response.status}`,
                            response: data
                        });
                    }
                },

                onerror: function (error) {

                    resolve({
                        success: false,
                        reason: '企业微信请求失败',
                        error
                    });
                },

                ontimeout: function () {

                    resolve({
                        success: false,
                        reason: '企业微信请求超时'
                    });
                }

            });

        });
    }


    /************************************************************
     * 10. EmailJS
     ************************************************************/

    function sendEmailJS(text, subject = '策略研究平台 - 今仓变化') {

        if (!config.emailEnabled) {

            return Promise.resolve({
                success: false,
                skipped: true
            });
        }


        const serviceId =
            String(config.emailServiceId || '').trim();

        const templateId =
            String(config.emailTemplateId || '').trim();

        const publicKey =
            String(config.emailPublicKey || '').trim();

        const accessToken =
            String(config.emailAccessToken || '').trim();

        const toEmail =
            String(config.emailTo || '').trim();


        if (
            !serviceId ||
            !templateId ||
            !publicKey
        ) {

            return Promise.resolve({
                success: false,
                reason: 'EmailJS 配置不完整'
            });
        }


        /*
         * EmailJS REST API
         *
         * https://api.emailjs.com/api/v1.0/email/send
         */

        const body = {

            service_id: serviceId,

            template_id: templateId,

            user_id: publicKey,

            template_params: {

                message: text,

                subject: subject,

                to_email: toEmail,

                time: nowString(),

                page_url: location.href,

                old_total:
                    state.lastTotal ?? '',

                new_total:
                    state.currentTotal ?? '',

                change:
                    state.lastChange ?? ''
            }
        };


        if (accessToken) {

            body.accessToken = accessToken;
        }


        return new Promise(resolve => {

            GM_xmlhttpRequest({

                method: 'POST',

                url: 'https://api.emailjs.com/api/v1.0/email/send',

                headers: {
                    'Content-Type': 'application/json'
                },

                data: JSON.stringify(body),

                timeout: 15000,

                onload: function (response) {

                    if (
                        response.status >= 200 &&
                        response.status < 300
                    ) {

                        resolve({
                            success: true,
                            response: response.responseText
                        });

                    } else {

                        resolve({
                            success: false,
                            reason:
                                `EmailJS HTTP ${response.status}`,
                            response:
                                response.responseText
                        });
                    }
                },

                onerror: function (error) {

                    resolve({
                        success: false,
                        reason: 'EmailJS 请求失败',
                        error
                    });
                },

                ontimeout: function () {

                    resolve({
                        success: false,
                        reason: 'EmailJS 请求超时'
                    });
                }

            });

        });
    }


    /************************************************************
     * 11. 桌面通知
     ************************************************************/

    function desktopNotify(title, text) {

        if (!config.desktopNotification) {
            return;
        }

        try {

            GM_notification({

                title,

                text,

                timeout: 8000

            });

        } catch (e) {}
    }


    /************************************************************
     * 12. 发送统一消息
     ************************************************************/

    async function sendNotification(
        text,
        subject = '策略研究平台'
    ) {

        updatePanelStatus(
            '正在发送通知...',
            'sending'
        );


        const results = await Promise.allSettled([

            sendWeCom(text),

            sendEmailJS(text, subject)

        ]);


        const wecom =
            results[0]?.value;

        const email =
            results[1]?.value;


        const successList = [];


        if (wecom?.success) {
            successList.push('企业微信');
        }

        if (email?.success) {
            successList.push('EmailJS');
        }


        if (successList.length) {

            state.lastStatus =
                '通知成功：' +
                successList.join(' + ');

            updatePanel();

        } else {

            state.lastStatus =
                '通知未发送';

            updatePanel();
        }


        return {
            wecom,
            email
        };
    }


    /************************************************************
     * 13. 运行通知
     ************************************************************/

    async function sendRuntimeNotification(status) {

        if (!config.runtimeNotification) {
            return;
        }


        const data = {

            status,

            total:
                state.currentTotal,

            time:
                nowString(),

            url:
                location.href
        };


        const text =
            renderTemplate(
                config.runtimeMessageTemplate,
                data
            );


        await sendNotification(
            text,
            '策略研究平台 - 运行通知'
        );
    }


    /************************************************************
     * 14. 检查今仓
     ************************************************************/

    async function checkTodayPosition(
        force = false
    ) {

        if (state.checking) {
            return;
        }

        if (!state.running && !force) {
            return;
        }


        state.checking = true;


        try {

            const data =
                getTradeData();


            if (!data.success) {

                state.lastStatus =
                    data.reason;

                updatePanel();

                return;
            }


            state.pageReady = true;

            state.currentTotal =
                data.total;

            state.lastCheckTime =
                nowString();


            /*
             * 第一次读取
             */
            if (!state.initialized) {

                state.lastTotal =
                    data.total;

                state.initialized = true;

                state.lastChange = 0;

                state.lastStatus =
                    `已建立基准：${formatNumber(data.total)} 手`;

                saveMonitorState();

                updatePanel();


                /*
                 * 首次启动不通知交易变化
                 */
                if (!config.firstRunAsBaseline) {

                    const text =
                        renderTemplate(
                            config.tradeMessageTemplate,
                            {
                                club: data.club,
                                oldTotal: 0,
                                newTotal: data.total,
                                total: data.total,
                                change: data.total,
                                details:
                                    buildDetails(data.rows),
                                time: data.time
                            }
                        );

                    await sendNotification(
                        text,
                        '策略研究平台 - 初始今仓'
                    );
                }


                return;
            }


            /*
             * 和上一次进行比较
             */
            const oldTotal =
                state.lastTotal;

            const newTotal =
                data.total;

            const change =
                newTotal - oldTotal;


            /*
             * 没变化
             */
            if (change === 0) {

                state.lastStatus =
                    '无变化';

                updatePanel();

                return;
            }


            /*
             * 发生变化
             */
            state.lastChange =
                change;


            state.lastStatus =
                change > 0
                    ? `今仓增加 ${formatNumber(change)} 手`
                    : `今仓减少 ${formatNumber(Math.abs(change))} 手`;


            /*
             * 先更新基准
             */
            state.lastTotal =
                newTotal;


            saveMonitorState();

            updatePanel();


            /*
             * 构建消息
             */
            const text =
                renderTemplate(
                    config.tradeMessageTemplate,
                    {
                        club: data.club,
                        oldTotal,
                        newTotal,
                        total: newTotal,
                        change,
                        details:
                            buildDetails(data.rows),
                        time: data.time
                    }
                );


            /*
             * 页面通知
             */
            desktopNotify(
                change > 0
                    ? '📈 今仓增加'
                    : '📉 今仓减少',
                `${formatNumber(oldTotal)} → ${formatNumber(newTotal)} 手`
            );


            /*
             * 企业微信 + EmailJS
             */
            await sendNotification(
                text,
                change > 0
                    ? '策略研究平台 - 今仓增加'
                    : '策略研究平台 - 今仓减少'
            );

        } catch (error) {

            console.error(
                '[今仓监控] 检查异常',
                error
            );

            state.lastStatus =
                '检查异常：' +
                (error?.message || error);

            updatePanel();

        } finally {

            state.checking = false;
        }
    }


    /************************************************************
     * 15. 保存监控状态
     ************************************************************/

    function saveMonitorState() {

        GM_setValue(
            'trade_monitor_state',
            {
                initialized:
                    state.initialized,

                lastTotal:
                    state.lastTotal,

                currentTotal:
                    state.currentTotal,

                lastChange:
                    state.lastChange,

                lastStatus:
                    state.lastStatus
            }
        );
    }


    /************************************************************
     * 16. 恢复监控状态
     ************************************************************/

    function loadMonitorState() {

        const saved =
            GM_getValue(
                'trade_monitor_state',
                null
            );

        if (!saved) {
            return;
        }

        state.initialized =
            !!saved.initialized;

        state.lastTotal =
            saved.lastTotal ?? null;

        state.currentTotal =
            saved.currentTotal ?? null;

        state.lastChange =
            saved.lastChange ?? null;

        state.lastStatus =
            saved.lastStatus ||
            '已恢复监控状态';
    }


    /************************************************************
     * 17. 启动监控
     ************************************************************/

    function startMonitoring() {

        stopMonitoring(false);


        state.running = true;

        config.enabled = true;

        saveConfig();


        /*
         * 立即检查一次
         */
        checkTodayPosition(true);


        /*
         * 定时器
         */
        state.timer =
            setInterval(
                () => {

                    checkTodayPosition(false);

                },
                Math.max(
                    5,
                    Number(config.interval) || 30
                ) * 1000
            );


        state.lastStatus =
            '监控运行中';

        updatePanel();


        /*
         * 运行通知只发送一次
         */
        if (
            !state.runtimeStartedNotificationSent
        ) {

            state.runtimeStartedNotificationSent =
                true;

            sendRuntimeNotification(
                '监控已启动'
            );
        }
    }


    /************************************************************
     * 18. 停止监控
     ************************************************************/

    function stopMonitoring(
        sendNotificationFlag = true
    ) {

        if (state.timer) {

            clearInterval(
                state.timer
            );

            state.timer = null;
        }


        state.running = false;

        config.enabled = false;

        saveConfig();


        state.lastStatus =
            '监控已暂停';

        updatePanel();


        if (sendNotificationFlag) {

            sendRuntimeNotification(
                '监控已暂停'
            );
        }
    }


    /************************************************************
     * 19. 重新建立基准
     ************************************************************/

    async function resetBaseline() {

        const data =
            getTradeData();


        if (!data.success) {

            alert(
                '无法建立基准：' +
                data.reason
            );

            return;
        }


        state.initialized = true;

        state.lastTotal =
            data.total;

        state.currentTotal =
            data.total;

        state.lastChange = 0;

        state.lastStatus =
            `基准已重置：${formatNumber(data.total)} 手`;


        saveMonitorState();

        updatePanel();


        await sendRuntimeNotification(
            `基准已重置为 ${formatNumber(data.total)} 手`
        );
    }


    /************************************************************
     * 20. 页面数据变化监听
     *
     * 不依赖页面是否在前台。
     *
     * AJAX 更新 DOM 后，可以提前触发检查。
     ************************************************************/

    function startMutationObserver() {

        if (state.observer) {
            return;
        }


        const target =
            document.querySelector('#products') ||
            document.body;


        if (!target) {
            return;
        }


        let debounceTimer = null;


        state.observer =
            new MutationObserver(() => {

                clearTimeout(
                    debounceTimer
                );


                debounceTimer =
                    setTimeout(() => {

                        if (
                            state.running
                        ) {

                            checkTodayPosition(false);
                        }

                    }, 1500);

            });


        state.observer.observe(
            target,
            {
                childList: true,
                subtree: true,
                characterData: true
            }
        );
    }


    /************************************************************
     * 21. 控制面板 CSS
     ************************************************************/

    function injectStyle() {

        const style =
            document.createElement('style');

        style.id =
