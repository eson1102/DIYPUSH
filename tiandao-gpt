                    if (config.enabled) {

                        stopMonitor();

                    } else {

                        startMonitor();
                    }
                }
            );


        document
            .querySelector('#tm-settings')
            .addEventListener(
                'click',
                showSettings
            );


        updateButton();

        updatePanel();
    }


