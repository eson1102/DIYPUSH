    /************************************************************
     * 24. 页面初始化
     ************************************************************/

    function init() {

        /*
         * 非交易记录页面：
         *
         * 直接退出。
         *
         * 不创建弹窗。
         */

        if (!isTargetPage()) {

            console.log(
                '[今仓监控] 非目标页面，不显示控制面板'
            );

            return;
        }


        console.log(
            '[今仓监控] 目标交易页面'
        );


        injectStyle();

        createPanel();

        setupMutationObserver();


        /*
         * 如果之前已经开启监控，
         * 刷新页面后自动恢复。
         */

        if (config.enabled) {

            setTimeout(
                () => {

                    startMonitor();

                },
                1000
            );
        }
    }


    /************************************************************
     * 25. 防止页面动态加载
     ************************************************************/

    function waitForTargetPage() {

        if (isTargetPage()) {

            init();

            return;
        }


        /*
         * 有些页面是 SPA / AJAX，
         * 初始加载时 #products 还没有出现。
         */

        let count = 0;


        const timer =
            setInterval(
                () => {

                    count++;


                    if (
                        isTargetPage()
                    ) {

                        clearInterval(
                            timer
                        );

                        init();

                        return;
                    }


                    if (count > 30) {

                        clearInterval(
                            timer
                        );
                    }

                },
                1000
            );
    }


    waitForTargetPage();


