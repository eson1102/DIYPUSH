// ==UserScript==
// @name         今仓变化监控 + 企业微信 + EmailJS
// @namespace    https://chatgpt.com/
// @version      4.0.0
// @description  监控交易记录页面今仓数量变化，支持企业微信机器人、EmailJS、自定义消息、运行通知
// @author       ChatGPT
//
// @match        http://*/*
// @match        https://*/*
//
// @grant        GM_xmlhttpRequest
// @grant        GM_notification
// @grant        GM_setValue
// @grant        GM_getValue
//
// @connect      qyapi.weixin.qq.com
// @connect      api.emailjs.com
//
// @run-at       document-idle
// ==/UserScript==

(function () {
    'use strict';

    /************************************************************
     * 1. 默认配置
     ************************************************************/

    const DEFAULT_CONFIG = {

        // 是否启动监控
        enabled: false,

        // 检查间隔
        interval: 5 * 60 * 1000,

        // 是否启用企业微信
        wechatEnabled: true,

        // 企业微信机器人地址
        wechatWebhook:
            'https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=86748ff7-e6d0-4c5f-b915-958ae95a885b',

        // 是否启用 EmailJS
        emailEnabled: false,

        // EmailJS
        emailServiceId: '',
        emailTemplateId: '',
        emailPublicKey: '',
        emailToEmail: '',

        // 自定义消息
        messageIncrease:
            '📈 今仓增加\n\n策略研究室：{{room}}\n品种：{{symbol}}\n今仓：{{today}}\n变化：+{{change}} 手\n\n当前页面：{{url}}\n时间：{{time}}',

        messageDecrease:
            '📉 今仓减少\n\n策略研究室：{{room}}\n品种：{{symbol}}\n今仓：{{today}}\n变化：{{change}} 手\n\n当前页面：{{url}}\n时间：{{time}}',

        messageNew:
            '🆕 今日开新仓\n\n策略研究室：{{room}}\n品种：{{symbol}}\n今仓：{{today}}\n新增：+{{change}} 手\n\n当前页面：{{url}}\n时间：{{time}}',

        messageClear:
            '🚨 今日仓位已清零\n\n策略研究室：{{room}}\n品种：{{symbol}}\n今仓：0\n减少：{{change}} 手\n\n当前页面：{{url}}\n时间：{{time}}',

        messageRun:
            '🟢 今仓监控运行中\n\n今仓笔数：{{count}}\n今仓手数：{{total}}\n\n检查间隔：{{interval}}\n时间：{{time}}',

        // 是否发送运行通知
        runNotify: true,

        // 是否发送浏览器通知
        browserNotify: true,

        // 首次启动是否通知
        startupNotify: true,

        // 是否只监控今仓
        todayOnly: true
    };


    /************************************************************
     * 2. 配置读取 / 保存
     ************************************************************/

    const STORAGE_KEY = 'today_position_monitor_config_v4';

    function loadConfig() {

        try {

            const raw = localStorage.getItem(STORAGE_KEY);

            if (!raw) {
                return JSON.parse(JSON.stringify(DEFAULT_CONFIG));
            }

            const saved = JSON.parse(raw);

            return Object.assign(
                {},
                DEFAULT_CONFIG,
                saved
            );

        } catch (e) {

            console.error(
                '[今仓监控] 配置读取失败',
                e
            );

            return JSON.parse(JSON.stringify(DEFAULT_CONFIG));
        }
    }


    let config = loadConfig();


    function saveConfig() {

        try {

            localStorage.setItem(
                STORAGE_KEY,
                JSON.stringify(config)
            );

            // 同时 GM 保存一份
            GM_setValue(
                STORAGE_KEY,
                JSON.stringify(config)
            );

            console.log(
                '[今仓监控] 配置已保存'
            );

        } catch (e) {

            console.error(
                '[今仓监控] 配置保存失败',
                e
            );
        }
    }


    /************************************************************
     * 3. 工具
     ************************************************************/

    function nowString() {

        const d = new Date();

        const pad = n =>
            String(n).padStart(2, '0');

        return (
            d.getFullYear() +
            '-' +
            pad(d.getMonth() + 1) +
            '-' +
            pad(d.getDate()) +
            ' ' +
            pad(d.getHours()) +
            ':' +
            pad(d.getMinutes()) +
            ':' +
            pad(d.getSeconds())
        );
    }


    function formatInterval(ms) {

        const minutes =
            Math.round(ms / 60000);

        if (minutes < 60) {
            return minutes + ' 分钟';
        }

        return (
            Math.floor(minutes / 60) +
            ' 小时 ' +
            minutes % 60 +
            ' 分钟'
        );
    }


    function escapeHtml(str) {

        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    }


    /************************************************************
     * 4. 页面识别
     ************************************************************/

    function isTargetPage() {

        /*
         * 不限制具体 URL。
         *
         * 通过页面特征判断是不是交易记录页面。
         */

        const bodyText =
            document.body
                ? document.body.innerText || ''
                : '';

        const hasProducts =
            !!document.querySelector('#products');

        const hasTradeHeaders =
            bodyText.includes('品种名称') &&
            bodyText.includes('今仓') &&
            bodyText.includes('昨仓');

        const hasStrategy =
            bodyText.includes('策略研究室');

        return (
            hasProducts &&
            hasTradeHeaders &&
            hasStrategy
        );
    }


    /************************************************************
     * 5. 解析今仓
     ************************************************************/

    function getPositionData() {

        const result = [];

        const tbody =
            document.querySelector('#products');

        if (!tbody) {
            return result;
        }

        const rows =
            tbody.querySelectorAll('tr');

        rows.forEach((row, index) => {

            const cells =
                row.querySelectorAll('td');

            if (cells.length < 12) {
                return;
            }

            const symbol =
                cells[1].innerText.trim();

            const direction =
                cells[2].innerText.trim();

            const positionText =
                cells[3].innerText.trim();

            const yesterdayText =
                cells[9].innerText.trim();

            const todayText =
                cells[10].innerText.trim();

            const price =
                cells[11].innerText.trim();

            const position =
                parseNumber(positionText);

            const yesterday =
                parseNumber(yesterdayText);

            const today =
                parseNumber(todayText);

            result.push({

                index,

                name:
                    cells[0].innerText.trim(),

                symbol,

                direction,

                position,

                yesterday,

                today,

                price
            });
        });

        return result;
    }


    function parseNumber(value) {

        if (
            value === null ||
            value === undefined ||
            value === ''
        ) {
            return 0;
        }

        const n =
            parseFloat(
                String(value)
                    .replace(/,/g, '')
                    .replace(/[^\d.-]/g, '')
            );

        return isNaN(n)
            ? 0
            : n;
    }


    /************************************************************
     * 6. 今仓统计
     ************************************************************/

    function getTodaySummary() {

        const positions =
            getPositionData();

        let total = 0;

        let count = 0;

        positions.forEach(item => {

            if (item.today > 0) {

                count++;

                total += item.today;
            }
        });

        return {

            positions,

            count,

            total
        };
    }


    /************************************************************
     * 7. 保存上一次状态
     ************************************************************/

    const STATE_KEY =
        'today_position_monitor_state_v4';


    function loadState() {

        try {

            const raw =
                localStorage.getItem(STATE_KEY);

            if (!raw) {
                return null;
            }

            return JSON.parse(raw);

        } catch (e) {

            return null;
        }
    }


    function saveState(state) {

        localStorage.setItem(
            STATE_KEY,
            JSON.stringify(state)
        );
    }


    /************************************************************
     * 8. 页面信息
     ************************************************************/

    function getRoomName() {

        const row =
            document.querySelector(
                '#clubs tr'
            );

        if (!row) {
            return '';
        }

        const cell =
            row.querySelector('td');

        return cell
            ? cell.innerText.trim()
            : '';
    }


    /************************************************************
     * 9. 消息模板
     ************************************************************/

    function renderMessage(
        template,
        data
    ) {

        let result =
            template;

        Object.keys(data).forEach(key => {

            result =
                result.replace(
                    new RegExp(
                        '\\{\\{' +
                        key +
                        '\\}\\}',
                        'g'
                    ),
                    data[key]
                );
        });

        return result;
    }


    /************************************************************
     * 10. 企业微信
     ************************************************************/

    function sendWechat(text) {

        if (
            !config.wechatEnabled ||
            !config.wechatWebhook
        ) {

            console.log(
                '[今仓监控] 企业微信未启用'
            );

            return Promise.resolve(false);
        }

        return new Promise(resolve => {

            GM_xmlhttpRequest({

                method: 'POST',

                url:
                    config.wechatWebhook,

                headers: {

                    'Content-Type':
                        'application/json'
                },

                data:
                    JSON.stringify({

                        msgtype: 'text',

                        text: {

                            content: text
                        }
                    }),

                timeout: 15000,

                onload: function (response) {

                    console.log(
                        '[今仓监控] 企业微信返回',
                        response.responseText
                    );

                    resolve(
                        response.status >= 200 &&
                        response.status < 300
                    );
                },

                onerror: function (error) {

                    console.error(
                        '[今仓监控] 企业微信发送失败',
                        error
                    );

                    resolve(false);
                },

                ontimeout: function () {

                    console.error(
                        '[今仓监控] 企业微信请求超时'
                    );

                    resolve(false);
                }
            });

        });
    }


    /************************************************************
     * 11. EmailJS
     ************************************************************/

    function sendEmail(text) {

        if (
            !config.emailEnabled
        ) {
            return Promise.resolve(false);
        }

        if (
            !config.emailServiceId ||
            !config.emailTemplateId ||
            !config.emailPublicKey
        ) {

            console.warn(
                '[今仓监控] EmailJS 参数不完整'
            );

            return Promise.resolve(false);
        }


        const data = {

            service_id:
                config.emailServiceId,

            template_id:
                config.emailTemplateId,

            user_id:
                config.emailPublicKey,

            template_params: {

                to_email:
                    config.emailToEmail,

                subject:
                    '今仓变化通知',

                message:
                    text,

                content:
                    text
            }
        };


        return new Promise(resolve => {

            GM_xmlhttpRequest({

                method: 'POST',

                url:
                    'https://api.emailjs.com/api/v1.0/email/send',

                headers: {

                    'Content-Type':
                        'application/json'
                },

                data:
                    JSON.stringify(data),

                timeout: 15000,

                onload: function (response) {

                    console.log(
                        '[今仓监控] EmailJS 返回',
                        response.status,
                        response.responseText
                    );

                    resolve(
                        response.status >= 200 &&
                        response.status < 300
                    );
                },

                onerror: function (error) {

                    console.error(
                        '[今仓监控] EmailJS 发送失败',
                        error
                    );

                    resolve(false);
                },

                ontimeout: function () {

                    console.error(
                        '[今仓监控] EmailJS 请求超时'
                    );

                    resolve(false);
                }
            });

        });
    }


    /************************************************************
     * 12. 浏览器通知
     ************************************************************/

    function browserNotify(title, text) {

        if (!config.browserNotify) {
            return;
        }

        try {

            GM_notification({

                title,

                text,

                timeout: 8000
            });

        } catch (e) {

            console.warn(
                '[今仓监控] 浏览器通知失败',
                e
            );
        }
    }


    /************************************************************
     * 13. 统一推送
     ************************************************************/

    async function pushMessage(
        title,
        text
    ) {

        console.log(
            '[今仓监控]',
            title,
            text
        );

        browserNotify(
            title,
            text
        );

        const tasks = [];

        if (config.wechatEnabled) {

            tasks.push(
                sendWechat(text)
            );
        }

        if (config.emailEnabled) {

            tasks.push(
                sendEmail(text)
            );
        }

        if (!tasks.length) {

            console.warn(
                '[今仓监控] 没有启用任何推送渠道'
            );

            return;
        }

        await Promise.allSettled(tasks);
    }


    /************************************************************
     * 14. 检测变化
     ************************************************************/

    let checking = false;


    async function checkNow(
        force = false
    ) {

        if (checking) {
            return;
        }

        if (!isTargetPage()) {

            console.log(
                '[今仓监控] 当前页面不是目标页面'
            );

            return;
        }

        checking = true;

        try {

            const summary =
                getTodaySummary();

            updatePanel(
                summary
            );


            const current = {

                date:
                    new Date()
                        .toISOString()
                        .slice(0, 10),

                positions:
                    summary.positions.map(item => ({
                        symbol:
                            item.symbol,

                        name:
                            item.name,

                        today:
                            item.today
                    })),

                count:
                    summary.count,

                total:
                    summary.total
            };


            const previous =
                loadState();


            /*
             * 第一次运行：
             *
             * 只建立基准。
             *
             * 不把昨天的仓位当成今天变化。
             */

            if (
                !previous ||
                previous.date !== current.date
            ) {

                saveState(current);

                updatePanel(
                    summary,
                    '已建立今日基准'
                );

                if (
                    force &&
                    config.startupNotify
                ) {

                    const text =
                        renderMessage(
                            config.messageRun,
                            {

                                count:
                                    summary.count,

                                total:
                                    summary.total,

                                interval:
                                    formatInterval(
                                        config.interval
                                    ),

                                time:
                                    nowString()
                            }
                        );

                    await pushMessage(
                        '监控启动',
                        text
                    );
                }

                return;
            }


            /*
             * 比较每个合约的今仓
             */

            const previousMap =
                {};

            previous.positions.forEach(item => {

                previousMap[
                    item.symbol
                ] = item;
            });


            let changed = false;


            for (
                const item
                of current.positions
            ) {

                const old =
                    previousMap[
                        item.symbol
                    ];


                const oldToday =
                    old
                        ? old.today
                        : 0;


                const newToday =
                    item.today;


                if (
                    oldToday === newToday
                ) {
                    continue;
                }


                changed = true;


                const delta =
                    newToday - oldToday;


                const room =
                    getRoomName();


                const data = {

                    room,

                    symbol:
                        item.name +
                        ' ' +
                        item.symbol,

                    today:
                        newToday,

                    change:
                        Math.abs(delta),

                    url:
                        location.href,

                    time:
                        nowString()
                };


                let template;


                /*
                 * 0 -> N
                 */

                if (
                    oldToday === 0 &&
                    newToday > 0
                ) {

                    template =
                        config.messageNew;

                }

                /*
                 * N -> 0
                 */

                else if (
                    oldToday > 0 &&
                    newToday === 0
                ) {

                    template =
                        config.messageClear;

                }

                /*
                 * 增加
                 */

                else if (
                    delta > 0
                ) {

                    template =
                        config.messageIncrease;

                }

                /*
                 * 减少
                 */

                else {

                    template =
                        config.messageDecrease;
                }


                const text =
                    renderMessage(
                        template,
                        data
                    );


                await pushMessage(
                    delta > 0
                        ? '今仓增加'
                        : '今仓减少',
                    text
                );
            }


            /*
             * 保存最新状态
             */

            saveState(current);


            updatePanel(
                summary,
                changed
                    ? '检测到变化，已推送'
                    : '无变化'
            );

        } catch (e) {

            console.error(
                '[今仓监控] 检查异常',
                e
            );

            updatePanel(
                null,
                '检查异常'
            );

        } finally {

            checking = false;
        }
    }


    /************************************************************
     * 15. 定时器
     ************************************************************/

    let monitorTimer = null;


    function startMonitor() {

        stopMonitor();


        config.enabled = true;

        saveConfig();


        updateButton();


        /*
         * 立即执行一次
         */

        checkNow(true);


        monitorTimer =
            setInterval(
                () => {

                    checkNow(false);

                },
                config.interval
            );


        updatePanel(
            null,
            '监控已启动'
        );


        console.log(
            '[今仓监控] 已启动'
        );
    }


    function stopMonitor() {

        if (monitorTimer) {

            clearInterval(
                monitorTimer
            );

            monitorTimer = null;
        }


        config.enabled = false;

        saveConfig();


        updateButton();


        updatePanel(
            null,
            '监控已停止'
        );


        console.log(
            '[今仓监控] 已停止'
        );
    }


    /************************************************************
     * 16. DOM 变化监听
     *
     * 防止页面 AJAX 更新以后，
     * 必须等 5 分钟才发现。
     *
     * 这里不立即重复推送，
     * 只是提前触发检查。
     ************************************************************/

    let mutationTimer = null;


    function setupMutationObserver() {

        const target =
            document.querySelector(
                '#products'
            );

        if (!target) {
            return;
        }


        const observer =
            new MutationObserver(
                function () {

                    if (!config.enabled) {
                        return;
                    }


                    clearTimeout(
                        mutationTimer
                    );


                    mutationTimer =
                        setTimeout(
                            () => {

                                checkNow(false);

                            },
                            1000
                        );
                }
            );


        observer.observe(
            target,
            {

                childList: true,

                subtree: true,

                characterData: true
            }
        );


        console.log(
            '[今仓监控] DOM监听已启动'
        );
    }


    /************************************************************
     * 17. 控制面板
     ************************************************************/

    let panel;


    function createPanel() {

        if (panel) {
            return;
        }


        panel =
            document.createElement(
                'div'
            );


        panel.id =
            'today-monitor-panel';


        panel.innerHTML = `

            <div class="tm-header">

                <div class="tm-title">
                    📊 今仓监控
                </div>

                <div
                    id="tm-status"
                    class="tm-status"
                >
                    未启动
                </div>

            </div>


            <div class="tm-body">

                <div class="tm-row">
                    <span>今仓笔数</span>
                    <b id="tm-count">0</b>
                </div>

                <div class="tm-row">
                    <span>今仓手数</span>
                    <b id="tm-total">0</b>
                </div>

                <div class="tm-row">
