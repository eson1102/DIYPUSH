    /************************************************************
     * 23. 面板事件
     ************************************************************/

    function bindPanelEvents() {

        const panel =
            document.getElementById(
                'trade-monitor-panel'
            );


        if (!panel) {
            return;
        }


        /*
         * 关闭
         */

        panel.querySelector(
            '.tm-close'
        ).onclick = function () {

            panel.style.display =
                'none';
        };


        /*
         * 设置
         */

        document.getElementById(
            'tm-config'
        ).onclick = function () {

            const area =
                document.getElementById(
                    'tm-config-area'
                );

            area.classList.toggle(
                'show'
            );
        };


        /*
         * 启动
         */

        document.getElementById(
            'tm-start'
        ).onclick = function () {

            startMonitoring();
        };


        /*
         * 暂停
         */

        document.getElementById(
            'tm-stop'
        ).onclick = function () {

            stopMonitoring(true);
        };


        /*
         * 立即检查
         */

        document.getElementById(
            'tm-check'
        ).onclick = function () {

            checkTodayPosition(true);
        };


        /*
         * 重建基准
         */

        document.getElementById(
            'tm-reset'
        ).onclick = function () {

            if (
                confirm(
                    '确定使用当前今仓重新建立基准？\n\n建立后不会因为当前数字而产生交易变化通知。'
                )
            ) {

                resetBaseline();
            }
        };


        /*
         * 保存设置
         */

        document.getElementById(
            'tm-save-config'
        ).onclick = function () {

            savePanelConfig();

        };


        /*
         * 测试推送
         */

        document.getElementById(
            'tm-test'
        ).onclick = async function () {

            const text =
`🔔 策略研究平台测试消息

今仓监控运行正常。

当前今仓：
${formatNumber(state.currentTotal)} 手

时间：
${nowString()}`;


            await sendNotification(
                text,
                '策略研究平台 - 测试消息'
            );

            alert(
                '测试推送已执行，请检查企业微信 / 邮箱。'
            );
        };


        /*
         * 拖动
         */

        makePanelDraggable(panel);
    }


