    /************************************************************
     * 19. 更新按钮
     ************************************************************/

    function updateButton() {

        const button =
            document.querySelector(
                '#tm-start'
            );

        const status =
            document.querySelector(
                '#tm-status'
            );


        if (!button) {
            return;
        }


        if (config.enabled) {

            button.innerHTML =
                '⏹ 停止监控';

            button.classList.add(
                'running'
            );


            if (status) {

                status.innerHTML =
                    '● 运行中';

                status.style.color =
                    '#2ecc71';
            }

        } else {

            button.innerHTML =
                '▶ 启动监控';

            button.classList.remove(
                'running'
            );


            if (status) {

                status.innerHTML =
                    '● 已停止';

                status.style.color =
                    '#aaa';
            }
        }
    }


    /************************************************************
     * 20. 更新面板
     ************************************************************/

    function updatePanel(
        summary,
        message
    ) {

        if (!panel) {
            return;
        }


        if (summary) {

            const count =
                document.querySelector(
                    '#tm-count'
                );

            const total =
                document.querySelector(
                    '#tm-total'
                );


            if (count) {
                count.textContent =
                    summary.count;
            }


            if (total) {
                total.textContent =
                    summary.total;
            }
        }


        const interval =
            document.querySelector(
                '#tm-interval'
            );


        if (interval) {

            interval.textContent =
                formatInterval(
                    config.interval
                );
        }


        const msg =
            document.querySelector(
                '#tm-message'
            );


        if (msg && message) {

            msg.textContent =
                message;
        }


        updateButton();
    }


