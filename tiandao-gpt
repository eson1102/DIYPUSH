    /************************************************************
     * 16. 更新面板状态
     ************************************************************/

    function updatePanelStatus(
        text
    ) {

        const el =
            document.getElementById(
                'tm-status'
            );


        if (!el) {
            return;
        }


        el.textContent = text;

    }


    function updatePanelData(
        data
    ) {

        const count =
            document.getElementById(
                'tm-count'
            );


        const total =
            document.getElementById(
                'tm-total'
            );


        const last =
            document.getElementById(
                'tm-last-check'
            );


        if (count) {

            count.textContent =
                data.count;

        }


        if (total) {

            total.textContent =
                data.totalLots;

        }


        if (last) {

            last.textContent =
                formatTime();

        }

    }


    function updatePanelNextCheck(
        interval
    ) {

        const next =
            document.getElementById(
                'tm-next-check'
            );


        if (next) {

            const nextTime =
                new Date(
                    Date.now() + interval
                );

            next.textContent =
                formatTime(nextTime);

        }

    }


    function updateToggleButton() {

        const button =
            document.getElementById(
                'tm-toggle'
            );


        if (!button) {
            return;
        }


        if (monitorEnabled) {

            button.textContent =
                '⏸ 暂停';

            button.className =
                'tm-btn tm-pause';

        }

        else {

            button.textContent =
                '▶ 恢复';

            button.className =
                'tm-btn tm-start';

        }

    }


    /************************************************************
     * 17. 暂停 / 恢复
     ************************************************************/

    function toggleMonitor() {

        monitorEnabled =
            !monitorEnabled;


        GM_setValue(
            'monitorEnabled',
            monitorEnabled
        );


        updateToggleButton();


        if (monitorEnabled) {

            updatePanelStatus(
                '已恢复'
            );


            /*
             * 恢复时立即建立一次当前状态。
             */

            checkNow();


            scheduleNextCheck();

        }

        else {

            if (timer) {

                clearTimeout(timer);

                timer = null;

            }


            updatePanelStatus(
                '已暂停'
            );

        }

    }


    /************************************************************
     * 18. 测试企业微信
     ************************************************************/

    async function sendTestMessage() {

        updatePanelStatus(
            '发送测试...'
        );


        const message =

`🔔 今仓监控测试通知

时间：${formatTime()}

监控系统：策略研究平台
状态：正常

如果你能看到这条消息，
说明企业微信群机器人连接正常。`;


        try {

            await sendWechatMessage(
                message
            );


            updatePanelStatus(
                '测试成功'
            );

        }

        catch (e) {

            console.error(e);

            updatePanelStatus(
                '测试失败'
            );

            alert(
                '企业微信通知发送失败，请检查控制台。'
            );

        }

    }


    /************************************************************
     * 19. 倒计时
     ************************************************************/

    let nextCheckTimestamp = null;


    function startCountdown() {

        setInterval(() => {

            const el =
                document.getElementById(
                    'tm-countdown'
                );


            if (!el) {
                return;
            }


            if (!nextCheckTimestamp) {

                el.textContent =
                    '等待下一次检查';

                return;

            }


            if (!monitorEnabled) {

                el.textContent =
                    '监控已暂停';

                return;

            }


            const diff =
                nextCheckTimestamp -
                Date.now();


            if (diff <= 0) {

                el.textContent =
                    '即将检查';

                return;

            }


            const totalSeconds =
                Math.floor(
                    diff / 1000
                );


            const minutes =
                Math.floor(
                    totalSeconds / 60
                );


            const seconds =
                totalSeconds % 60;


            el.textContent =
                `下次检查还有 ${minutes}分 ${String(seconds).padStart(2, '0')}秒`;

        }, 1000);

    }


    /*
     * 修改 scheduleNextCheck，
     * 增加倒计时记录。
     */

    const originalSchedule =
        scheduleNextCheck;


    /************************************************************
     * 20. 覆盖调度函数
     ************************************************************/

    function scheduleNextCheck2() {

        if (timer) {

            clearTimeout(timer);

            timer = null;

        }


        if (!monitorEnabled) {

            updatePanelStatus(
                '已暂停'
            );

            nextCheckTimestamp = null;

            return;

        }


        const interval =
            randomInterval();


        nextCheckTimestamp =
            Date.now() + interval;


        const minutes =
            Math.round(
                interval / 60000
            );


        console.log(
            `[今仓监控] 下一次检查：${minutes} 分钟后`
        );


        updatePanelNextCheck(
            interval
        );


        timer = setTimeout(
            async () => {

                await checkNow();

                scheduleNextCheck2();

            },
            interval
        );

    }


    /************************************************************
     * 21. 页面初始化
     ************************************************************/

    async function init() {

        console.log(
            '================================'
        );

        console.log(
            '策略研究平台 - 今仓监控启动'
        );

        console.log(
            '================================'
        );


        /*
         * 创建控制面板
         */

        createPanel();


        startCountdown();


        /*
         * 等待页面数据加载。
         *
         * 页面如果是 Ajax 动态加载，
         * 直接运行可能还没有 #products。
         */

        let retry = 0;


        while (
            !document.querySelector(
                CONFIG.productsSelector
            ) &&
            retry < 30
        ) {

            await sleep(1000);

            retry++;

        }


        if (!document.querySelector(
            CONFIG.productsSelector
        )) {

            updatePanelStatus(
                '未找到交易数据'
            );

            console.error(
                '[今仓监控] 未找到 #products'
            );

            return;

        }


        /*
         * 第一次读取。
         *
         * 只建立基准，不通知。
         */

        await checkNow();


        /*
         * 运行通知
         */

        if (
            CONFIG.sendStartupNotification &&
            monitorEnabled
        ) {

            await sendStartupMessage();

        }


        /*
         * 启动自动检查
         */

        scheduleNextCheck2();

    }


    /************************************************************
     * 22. 启动
     ************************************************************/

    setTimeout(
        init,
        1500
    );


})();
